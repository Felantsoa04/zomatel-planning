# ───────────────────────── helper nouveau paginé ─────────────────────────

def new_section_front(macro=False):
    s = doc.add_section(WD_SECTION.NEW_PAGE)
    for sec in doc.sections:
        pass
    return s

def page_break():
    doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)
